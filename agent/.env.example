# Copy this file to agent/.env and fill in the values.
#
#   cp agent/.env.example agent/.env
#
# IMPORTANT: values MUST be unquoted — no surrounding " or '. A quoted
# LANGSMITH_GATEWAY_API_KEY is the most common first-run failure (the Gateway
# call fails auth). The agent, the simulator, and the evals all read this file.

# --- LangSmith -------------------------------------------------------------

# Enable tracing. Keep true so runs, experiments, and dashboards populate.
LANGSMITH_TRACING=true

# Your LangSmith WORKSPACE API key: Settings -> API Keys -> Create API Key.
# Authenticates tracing, datasets/experiments, `mda` deploys, and the Engine API.
LANGSMITH_API_KEY=lsv2_pt_...

# Tracing project name for LOCAL runs (any name; created on first trace).
LANGSMITH_PROJECT=kyb-agent-local

# --- LLM Gateway -----------------------------------------------------------

# Route every `langsmith:provider/model` id through the LLM Gateway. This is a
# boolean flag, not a URL and not a secret.
LANGSMITH_GATEWAY=true

# The Gateway API key: LangSmith -> Gateway -> API Keys.
# NOTE: provider keys (e.g. ANTHROPIC_API_KEY) are NOT set here — they live as a
# Gateway WORKSPACE SECRET (see SETUP.md, Prerequisites). The project never holds
# a provider key.
LANGSMITH_GATEWAY_API_KEY=...
